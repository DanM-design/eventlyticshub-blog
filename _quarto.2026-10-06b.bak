# --------------------------------------------------
# _quarto.yml — EventlyticsHub
# Structure identical to your repo. Two changes only,
# both marked CHANGED below.
# --------------------------------------------------

project:
  type: website

website:
  title: "Event Analytics Hub"
  site-url: https://www.eventlyticshub.com
  page-navigation: true
  open-graph: true
  cookie-consent:
    type: express
    style: simple
    palette: dark
  search: true

  navbar:
    pinned: true
    right:
      - text: "work with me \u2192"
        href: work-with-me.qmd

  sidebar:
    title: ""
    style: docked
    align: left
    collapse-level: 1
    contents:
      - text: "Read the analysis"
        href: blog.qmd
      - section: "Getting started"
        contents:
          - text: "What are events?"
            href: guide/getting-started/what-are-events.qmd
          - text: "Why event-driven?"
            href: guide/getting-started/why-event-driven.qmd
      - section: "Core Concepts"
        contents:
          - text: "Signal"
            href: "#"
          - text: "Noise"
            href: "#"
          - text: "Event"
            href: "#"
          - text: "Modeled event"
            href: "#"
          - text: "Unmodeled event"
            href: "#"
          - text: "Data warehouse and BI"
            href: "#"
          - text: "Exploration Layer"
            href: "#"
          - text: "Knowledge Recipe"
            href: "#"
          - text: "Exploratory Data Analysis"
            href: "#"
      - section: "Business Value"
        contents:
          - text: "Overview"
            href: "#"
      - section: "Early Signals"
        contents:
          - text: "Weak signals"
            href: "#"
          - text: "Missed signals"
            href: "#"
          - text: "Signal-to-event speed"
            href: "#"
          - text: "Noise"
            href: "#"
      - section: "Events"
        contents:
          - text: "Recognition"
            href: "#"
          - text: "Context"
            href: "#"
          - text: "Patterns"
            href: "#"
          - text: "Modeled and unmodeled"
            href: "#"
      - section: "Exploration Layer"
        contents:
          - text: "Signal exploration"
            href: "#"
          - text: "Noise exploration"
            href: "#"
          - text: "Event decision"
            href: "#"
          - text: "Prior art"
            href: "#"
      - section: "Platform Architecture"
        contents:
          - text: "Existing layers"
            href: "#"
          - text: "Connections"
            href: "#"
          - text: "Event-driven architecture"
            href: "#"
          - text: "Events as facts"
            href: "#"
      - section: "Knowledge Recipe"
        contents:
          - text: "Recipe parts"
            href: "#"
          - text: "Promotion"
            href: "#"
          - text: "Knowledge drift"
            href: "#"
          - text: "Knowledge inertia"
            href: "#"
      - section: "Cases"
        contents:
          - text: "Nokia"
            href: "#"
          - text: "Sears"
            href: "#"
          - text: "Customer interaction"
            href: "#"
          - text: "Logistics"
            href: "#"
      - section: "Dashboards"
        contents:
          - text: "Dashboard design"
            href: guide/dashboards/dashboard-design.qmd
      - text: "Explore the data \u2192"
        href: explore.qmd

  page-footer:
    left: "© 2026 Dan Manastireanu"
    center: "R · Shiny · Quarto · Docker"
    right: "Powered by [Quarto](https://quarto.org/)"

format:
  html:
    grid:
      sidebar-width: 250px
      body-width: 1000px
      margin-width: 300px
      gutter-width: 1.5rem
    theme:
      dark: [darkly, style/dark.scss, style/base.scss]
      light: [flatly, style/light.scss, style/base.scss]
    toc: true
    toc-location: right
    toc-depth: 3
    code-fold: show
    code-copy: true
    fontsize: 1.05rem
    linestretch: 1.7

execute:
  freeze: auto
  cache: false
